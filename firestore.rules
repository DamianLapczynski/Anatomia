rules_version = '2';
// Każdy użytkownik widzi i zmienia wyłącznie własne dane: users/{uid}/...
// Żeby zablokować zakładanie danych przez obce konta, dopisz w konsoli: && request.auth.uid == '<Twój uid>'
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{ns}/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && ns in ['srs', 'quiz', 'learn', 'settings'];
    }
  }
}
